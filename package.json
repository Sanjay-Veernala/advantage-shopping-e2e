{
  "name": "advantage-shopping-e2e",
  "version": "1.0.0",
  "description": "Playwright + TypeScript E2E framework for Advantage Online Shopping (POM)",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:auth": "playwright test tests/auth",
    "test:shopping": "playwright test tests/shopping",
    "report": "playwright show-report",
    "lint": "tsc --noEmit",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report"
  },
  "keywords": [
    "playwright",
    "e2e",
    "pom",
    "advantage-shopping"
  ],
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^26.2.0",
    "allure-playwright": "^3.10.2",
    "dotenv": "^17.2.3",
    "typescript": "^5.9.3"
  }
}
